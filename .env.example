# =================================================================
# SAIF VEGETABLE ENVIRONMENT SECRETS & CONFIGURATION
# Configure secrets in AI Studio Secrets Panel or in server environment.
# =================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# =================================================================
# SMS GATEWAY PROVIDERS FOR REAL SMS OTP (Choose ONE provider)
# =================================================================

# Option 1: Fast2SMS (Recommended for Indian Mobile Numbers - Quick Setup)
# Get key from: https://www.fast2sms.com/dashboard/dev-api
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio SMS Gateway (Global & India SMS)
# Get credentials from: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_e164

# Option 3: MSG91 (DLT Approved Indian SMS Gateway)
# Get credentials from: https://msg91.com/
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_template_id
